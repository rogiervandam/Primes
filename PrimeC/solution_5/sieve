#!/bin/bash

# Detect OS
OS="$(uname -s)"
ARCH="$(uname -m)"

# Color codes
CYELLOW="\033[1;33m"
CCYAN="\033[1;36m"
CGREEN="\033[1;32m"
CRESET="\033[0m"

# Initialize compiler override variable
COMPILER_OVERRIDE=""
RUNALL=""
COMPILE=""
COMPILEFULL=""
EMBED=""
VISUALIZE=""
VISUALIZE_MODE="" # "native", "web", or "" (auto)
RENDER=""
STABLE_MODE=""
STABLE_SETUP=""
STABLE_WSL_HOST=""
CHAIN=""
CHAIN_EMBED_MODE=""  # "embedded" variant: COMPILE_BENCHMARK_STRIPERS + EMBED_SETTINGS
CHAIN_TIMING_MODE="" # "timing" variant: COMPILE_TIMERS + EMBED_SETTINGS
CHAIN_EXPLAIN_MODE="" # "explain" flag: add COMPILE_EXPLAIN to trace binary
CHAIN_TITLE=""
SIEVEVARIANTS="sieve_classic8 sieve_classic64 sieve_base sieve_wheel sieve_wheel_8of30 sieve_wheelstorage sieve_extend"

# Process arguments to check for compiler override
ARGS_TO_KEEP=()
TRACE_FILENAME=""
TRACE_EXPECTING_FILENAME=0
TRACE_LEVEL_OVERRIDE=""
TRACE_EXPECTING_LEVEL=0
TRACE_USER_REQUESTED=0
TRACE_TITLE=""
TRACE_EXPECTING_TITLE=0
CHAIN_EXPECTING_TITLE=0
BENCHMARK_LOG_FILENAME=""
BENCHMARK_LOG_EXPECTING_FILENAME=0
USER_SET_OVERRIDE=""
SET_EXPECTING_VALUE=0
for arg in "$@"; do
    if [ "$TRACE_EXPECTING_LEVEL" -eq 1 ]; then
        if echo "$arg" | grep -qE '^[0-9]+$'; then
            TRACE_LEVEL_OVERRIDE="$arg"
            TRACE_EXPECTING_LEVEL=0
            continue
        fi
        echo "Error: --trace requires a trace level (5-9) to follow it." >&2
        exit 1
    fi

    if [ "$TRACE_EXPECTING_FILENAME" -eq 1 ]; then
        TRACE_FILENAME="$arg"
        TRACE_EXPECTING_FILENAME=0
        continue
    fi

    if [ "$TRACE_EXPECTING_TITLE" -eq 1 ]; then
        TRACE_TITLE="$arg"
        TRACE_EXPECTING_TITLE=0
        continue
    fi

    if [ "$CHAIN_EXPECTING_TITLE" -eq 1 ]; then
        CHAIN_TITLE="$arg"
        CHAIN_EXPECTING_TITLE=0
        continue
    fi

    if [ "$BENCHMARK_LOG_EXPECTING_FILENAME" -eq 1 ]; then
        BENCHMARK_LOG_FILENAME="$arg"
        BENCHMARK_LOG_EXPECTING_FILENAME=0
        continue
    fi

    if [ "$SET_EXPECTING_VALUE" -eq 1 ]; then
        USER_SET_OVERRIDE="$arg"
        SET_EXPECTING_VALUE=0
        ARGS_TO_KEEP+=("$arg")
        continue
    fi

    if [ "$arg" = "gcc" ]; then
        COMPILER_OVERRIDE="gcc"
    elif [ "$arg" = "clang" ]; then
        COMPILER_OVERRIDE="clang"
    elif [ "$arg" = "intel" ] || [ "$arg" = "icx" ] || [ "$arg" = "oneapi" ]; then
        COMPILER_OVERRIDE="icx"
    elif [ "$arg" = "asm" ]; then
        COMPILER_ASM="asm"
    elif [ "$arg" = "runall" ]; then
        RUNALL="runall"
    elif [ "$arg" = "test" ]; then
        TESTALL="testall"
    elif [ "$arg" = "testall" ]; then
        TESTALL="testall"
    elif [ "$arg" = "compile" ]; then
        COMPILE="compile"
    elif [ "$arg" = "compileall" ]; then
        COMPILE="compileall"
    elif [ "$arg" = "compilefull" ]; then
        COMPILE_FULL="compilefull"
    elif [ "$arg" = "--embed" ] || [ "$arg" = "embed" ]; then
        EMBED="embed"
    elif [ "$arg" = "embedded" ]; then
        CHAIN_EMBED_MODE="embedded"
    elif [ "$arg" = "timing" ]; then
        CHAIN_TIMING_MODE="timing"
    elif [ "$arg" = "explain" ]; then
        CHAIN_EXPLAIN_MODE="explain"
    elif [ "$arg" = "visualize" ] || [ "$arg" = "visual" ]; then
        VISUALIZE="visualize"
    elif [ "$arg" = "native" ]; then
        VISUALIZE_MODE="native"
    elif [ "$arg" = "web" ]; then
        VISUALIZE_MODE="web"
    elif [ "$arg" = "render" ]; then
        RENDER="render"
    elif [ "$arg" = "stable" ] || [ "$arg" = "--stable" ]; then
        STABLE_MODE="stable"
    elif [ "$arg" = "stable-setup" ] || [ "$arg" = "--stable-setup" ]; then
        STABLE_SETUP="stable-setup"
    elif [ "$arg" = "stable-wsl-host" ] || [ "$arg" = "--stable-wsl-host" ]; then
        STABLE_WSL_HOST="stable-wsl-host"
    elif [ "$arg" = "trace" ] || [ "$arg" = "--trace" ]; then
        TRACE="trace"
        TRACE_USER_REQUESTED=1
        TRACE_EXPECTING_LEVEL=1
    elif [ "$arg" = "chain" ] || [ "$arg" = "--chain" ]; then
        CHAIN_EXPECTING_TITLE=1
        CHAIN="chain"
    elif [ "$arg" = "trace-filename" ] || [ "$arg" = "--trace-filename" ]; then
        TRACE_EXPECTING_FILENAME=1
    elif [ "$arg" = "trace-title" ] || [ "$arg" = "--trace-title" ]; then
        TRACE_EXPECTING_TITLE=1
    elif [ "$arg" = "benchmark-log" ] || [ "$arg" = "--benchmark-log" ]; then
        BENCHMARK_LOG_EXPECTING_FILENAME=1
    elif [ "$arg" = "chain" ] || [ "$arg" = "--chain" ]; then
        CHAIN_EXPECTING_TITLE=1
    elif [ "$arg" = "--set" ]; then
        SET_EXPECTING_VALUE=1
        ARGS_TO_KEEP+=("$arg")
    else
        ARGS_TO_KEEP+=("$arg")
    fi
done

# If --trace appeared last with no following token, error out.
if [ "$TRACE_EXPECTING_LEVEL" -eq 1 ]; then
    echo "Error: --trace requires a trace level (5-9) to follow it." >&2
    exit 1
fi
if [ "$TRACE_EXPECTING_FILENAME" -eq 1 ]; then
    echo "Error: --trace-filename requires a filename to follow it." >&2
    exit 1
fi
if [ "$CHAIN_EXPECTING_TITLE" -eq 1 ]; then
    echo "Error: --chain requires a title to follow it." >&2
    exit 1
fi
if [ "$BENCHMARK_LOG_EXPECTING_FILENAME" -eq 1 ]; then
    echo "Error: --benchmark-log requires a filename to follow it." >&2
    exit 1
fi
# If user requested --trace but didn't supply a level on the command line, error.
if [ "$TRACE_USER_REQUESTED" -eq 1 ] && [ -z "$TRACE_LEVEL_OVERRIDE" ]; then
    echo "Error: --trace requires a trace level (5-9) to follow it." >&2
    exit 1
fi
# Replace arguments with the filtered list
set -- "${ARGS_TO_KEEP[@]}"

STRIP="strip"
PAREXT="_epar"

base="sieve_extend" 

DEFINE_FLAGS=""

# Visualize mode automatically enables trace logging
if [ "$VISUALIZE" = "visualize" ] || [ "$TRACE" = "trace" ]; then
    DEFINE_FLAGS="-DCOMPILE_TRACE"
fi

PROGRAM_SUFFIX=""
if [ "$VISUALIZE" = "visualize" ] || [ "$TRACE" = "trace" ]; then
    PROGRAM_SUFFIX="_trace"
fi
if [ "$CHAIN_TIMING_MODE" = "timing" ]; then
    DEFINE_FLAGS="-DCOMPILE_TIMERS $DEFINE_FLAGS"
    PROGRAM_SUFFIX="_timing"
elif [ "$CHAIN_EMBED_MODE" = "embedded" ]; then
    PROGRAM_SUFFIX="_embedded"
fi

# Set default tokens
verbose_level=10  
compile_verbose_level=0
explain_level=0
trace_level=0
verbose_next=0
highest_number=0
threads=0
tune_level=1
tune_next=0
check_level=0
check_next=0
threads_next=0

# Loop through all arguments.
for arg in "$@"; do
    # Split each argument on dash and check every token.

    # Check if previous arg was --verbose and this is the value
    if [ $verbose_next -eq 1 ]; then
        if echo "$arg" | grep -q '^[0-9]\+$'; then
            verbose_level="$arg"
        fi
        verbose_next=0
        continue
    fi
    
    # Check if previous arg was --tune and this is the value
    if [ $tune_next -eq 1 ]; then
        if echo "$arg" | grep -q '^[0-9]\+$'; then
            tune_level="$arg"
        fi
        tune_next=0
        continue
    fi

    # Check if previous arg was --check and this is the value
    if [ $check_next -eq 1 ]; then
        if echo "$arg" | grep -q '^[0-9]\+$'; then
            check_level="$arg"
        fi
        check_next=0
        continue
    fi

    # Check if previous arg was --threads and this is the value
    if [ $threads_next -eq 1 ]; then
        if echo "$arg" | grep -q '^[0-9]\+$'; then
            threads="$arg"
        fi
        threads_next=0
        continue
    fi

    # Check for standalone --verbose flag
    if [ "$arg" = "--verbose" ] || [ "$arg" = "verbose" ]; then
        verbose_next=1
        continue
    fi
    
    # Check for standalone --tune flag
    if [ "$arg" = "--tune" ] || [ "$arg" = "tune" ]; then
        tune_next=1
        continue
    fi

    # Check for standalone --check flag
    if [ "$arg" = "--check" ] || [ "$arg" = "check" ]; then
        check_next=1
        continue
    fi

    if [ "$arg" = "--threads" ] || [ "$arg" = "threads" ]; then
        threads_next=1
        threads=1
        continue
    fi

    # Check if the argument is a number and update the highest number
    if echo "$arg" | grep -qE '^[0-9]+$'; then
        if [ "$arg" -gt "$highest_number" ]; then
            highest_number="$arg"
        fi
        continue
    fi

    for token in $(echo "$arg" | tr '-' ' '); do
        case "$token" in
            explain|--explain)
                DEFINE_FLAGS="-DCOMPILE_EXPLAIN $DEFINE_FLAGS"
                explain_level=6
                ;;
            timers|--timers)
                DEFINE_FLAGS="-DCOMPILE_TIMERS $DEFINE_FLAGS"
                ;;
            # Ignore other tokens.
        esac
    done
done

# If tune level is 5 or higher, add the COMPILE_BENCHMARK_STRIPERS flag
if [ "$tune_level" -ge 5 ]; then
    DEFINE_FLAGS="-DCOMPILE_BENCHMARK_STRIPERS $DEFINE_FLAGS"
fi

if [ "$tune_level" -ge 1 ]; then
    DEFINE_FLAGS="-DCOMPILE_TUNE $DEFINE_FLAGS"
fi

# If check level is 4 or higher, add the COMPILE_CHECK_STRIPERS flag
if [ "$check_level" -ge 4 ]; then
    DEFINE_FLAGS="-DCOMPILE_CHECK_STRIPERS $DEFINE_FLAGS"
fi

if [ "$COMPILE_FULL" = "compilefull" ]; then
    DEFINE_FLAGS="-DCOMPILE_FULL $DEFINE_FLAGS"
fi

if [ "$CHAIN_EXPLAIN_MODE" = "explain" ]; then
    DEFINE_FLAGS="-DCOMPILE_EXPLAIN $DEFINE_FLAGS"
    if [ "$explain_level" -lt 6 ]; then explain_level=6; fi
fi

# Add default verbose arguments if not explicitly specified
run_args=""

# Detect doing the full benchmark: 
# - running in docker container
# - and environment variable DOCKERFILE_TYPE is not set
# Then: set verbose level to 0 and runall
if [ -z "$DOCKERFILE_TYPE" ] && [ -f /.dockerenv ] && [ $verbose_level -eq 10 ]; then
    $0 runall "$@" --verbose 0
    exit 0
fi

if [ $verbose_level -eq 10 ]; then
    run_args="$run_args --verbose 2"
    verbose_level=2
fi

if [ "$VISUALIZE" = "visualize" ] || [ "$TRACE" = "trace" ]; then
    if [ -n "$TRACE_LEVEL_OVERRIDE" ]; then
        trace_level="$TRACE_LEVEL_OVERRIDE"
    else
        trace_level=9
    fi
fi

# Add --trace to run_args when trace or visualize is active.
# --trace now requires a trace level argument; fall back to the computed default for auto-enabled visualize mode.
if [ "$TRACE" = "trace" ] || [ "$VISUALIZE" = "visualize" ]; then
    run_args="$run_args --trace $trace_level"
    if [ -n "$TRACE_FILENAME" ]; then
        run_args="$run_args --trace-filename $TRACE_FILENAME"
    fi
fi

# Pass benchmark log filename through to the executable when given.
if [ -n "$BENCHMARK_LOG_FILENAME" ]; then
    run_args="$run_args --benchmark-log $BENCHMARK_LOG_FILENAME"
fi

# Forward the sieve max: use the explicitly provided number, or default to 10000 for visualize mode
if [ "$highest_number" -gt 0 ]; then
    run_args="$run_args --max $highest_number"
elif [ "$VISUALIZE" = "visualize" ]; then
    run_args="$run_args --max 10000"
fi


compile_verbose_level="$verbose_level"
if [ "$compile_verbose_level" -le "$explain_level" ]; then
    compile_verbose_level=$((explain_level + 1))
fi
if [ "$compile_verbose_level" -le "$trace_level" ]; then
    compile_verbose_level=$((trace_level + 1))
fi

DEFINE_FLAGS="-DCOMPILE_VERBOSE_LEVEL=$compile_verbose_level $DEFINE_FLAGS"

# Check if the highest number fits in 32 bits
if [ "$highest_number" -gt 999999999 ]; then
    echo "Number exceeds 32-bit range. Using 64-bit counter."
    DEFINE_FLAGS="$DEFINE_FLAGS -DUSE_64BIT_COUNTER"
fi


[ -d ./dev ] || mkdir ./dev
[ -d ./dev/build ] || mkdir ./dev/build
[ -d ./dev/docker ] || mkdir ./dev/docker
[ -d ./dev/dockerfiles ] || mkdir ./dev/dockerfiles

is_wsl_environment() {
    [ "$OS" = "Linux" ] && { [ -n "$WSL_DISTRO_NAME" ] || grep -qi microsoft /proc/version 2>/dev/null; }
}

if [ "$STABLE_SETUP" = "stable-setup" ]; then
    if is_wsl_environment && command -v powershell.exe >/dev/null 2>&1; then
        PS1_WIN_PATH=$(wslpath -w "$(pwd)/dev/benchmark/setup-wsl-benchmark.ps1")
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS1_WIN_PATH" \
            -Processors "${PRIME_BENCHMARK_WSL_PROCESSORS:-1}" \
            -MemoryGb "${PRIME_BENCHMARK_WSL_MEMORY_GB:-4}" \
            -SwapGb "${PRIME_BENCHMARK_WSL_SWAP_GB:-0}"
        exit $?
    fi

    if [ "$OS" = "Linux" ]; then
        echo "stable-setup: no host setup needed on native Linux."
        exit 0
    fi

    if [ "$OS" = "Darwin" ]; then
        echo "stable-setup: no host setup needed on macOS."
        exit 0
    fi

    echo "stable-setup is only supported from WSL/Linux/macOS shells."
    exit 1
fi

if [ "$STABLE_WSL_HOST" = "stable-wsl-host" ] && ! is_wsl_environment; then
    echo "stable-wsl-host must be run from inside WSL."
    echo "Use './dev/benchmark/run-wsl-benchmark.ps1' from Windows PowerShell if you are not in WSL."
    exit 1
fi

# Check for Docker argument first
if [ $# -gt 0 ] && [ "$1" = "docker" ]; then
    if [ $# -gt 1 ]; then
        DOCKER_TYPE="$2"

        # support running all Dockerfiles
        if [ "$DOCKER_TYPE" = "all" ]; then
            for DOCKERFILE in ./dev/docker/Dockerfile_*; do
                if [[ "$DOCKERFILE" == *"Dockerfile_common"* ]]; then
                    continue
                fi
                EXTENSION="${DOCKERFILE#*Dockerfile_}" # Extract the extension
                # RUN the same command line again, but "all" is replaced with the actual extension
                $0 docker "$EXTENSION" "${@:3}"
            done
            exit 0
        fi

        if [ "$DOCKER_TYPE" = "default" ]; then
            DOCKERFILE="Dockerfile"
            DOCKERFILE_FULL="Dockerfile"
            DOCKER_TYPE="default"
            shift 2
        else
            # support running a single Dockerfile
            DOCKERFILE="dev/docker/Dockerfile_$DOCKER_TYPE"
            DOCKERFILE_FULL="dev/dockerfiles/Dockerfile_$DOCKER_TYPE"
            if [ -f "$DOCKERFILE" ]; then
                # Build the Docker image
                cat "$DOCKERFILE" > "$DOCKERFILE_FULL"
                echo "" >> "$DOCKERFILE_FULL"
                cat "./dev/docker/Dockerfile_common" >> "$DOCKERFILE_FULL"

                # Check if third argument is "set" to copy Dockerfile to main directory
                if [ $# -gt 2 ] && [ "$3" = "set" ]; then
                    # Copy the Dockerfile to the main directory
                    cp "$DOCKERFILE_FULL" "./Dockerfile"
                    echo -e "Copied ${CYELLOW}$DOCKERFILE_FULL${CRESET} to ./Dockerfile"
                    exit 0
                else
                    # Original behavior: shift past the first two arguments only
                    shift 2
                fi
            else
                echo -e "Error: Dockerfile '${CYELLOW}$DOCKERFILE${CRESET}' not found."
                exit 1
            fi
        fi
    else
        echo "Docker type not specified. Using default"
        DOCKERFILE="Dockerfile"
        DOCKERFILE_FULL="Dockerfile"
        DOCKER_TYPE="default"
        shift 1
    fi

    if [ $verbose_level -gt 1 ]; then
        echo -e "Building and running Docker container for type: ${CYELLOW}$DOCKER_TYPE${CRESET}"
        echo -e "Running command: docker build --pull --file ${CYELLOW}$DOCKERFILE_FULL${CRESET} --rm -t ${CYELLOW}sieve_$DOCKER_TYPE${CRESET} ." 
    fi

    # Check if the Docker image exists before attempting to remove it
    if [ "$(docker images -q "sieve_$DOCKER_TYPE" 2> /dev/null)" ]; then
        docker rmi "sieve_$DOCKER_TYPE"
    fi

    docker build --pull --file "$DOCKERFILE_FULL" --rm -t "sieve_$DOCKER_TYPE" . 2> ./dev/build/docker_sieve_${DOCKER_TYPE}_build.log
    if [ $? -ne 0 ]; then
        echo "Error: Docker build failed."
        exit 1
    fi
    
    # Run the Docker container with any remaining arguments
    if [ $verbose_level -gt 1 ]; then
        echo -e "Running Docker container with arguments: $@"
        echo -e "Run with: docker run --rm -e DOCKERFILE_TYPE=\"${CYELLOW}$DOCKER_TYPE${CRESET}\" \"${CYELLOW}sieve_$DOCKER_TYPE${CRESET}\" $@ $COMPILER_OVERRIDE" 
        echo -e "Go in with: docker run --rm --name "${CYELLOW}sieve_$DOCKER_TYPE${CRESET}" -e DOCKERFILE_TYPE=${CYELLOW}$DOCKER_TYPE${CRESET} -it --entrypoint /bin/bash ${CYELLOW}sieve_$DOCKER_TYPE${CRESET}"  
    fi
    docker run --rm --name "sieve_$DOCKER_TYPE" -e DOCKERFILE_TYPE="$DOCKER_TYPE" "sieve_$DOCKER_TYPE" $@ $COMPILER_OVERRIDE
    exit $?
fi

if [ "$COMPILE" = "compileall" ]; then
    for base in $SIEVEVARIANTS; do
    # for base in sieve_base sieve_extend sieve_classic64 sieve_classic8 sieve_wheel sieve_wheel_8of30; do
        $0 $base "compile" "$@" || exit $?
    done
    exit 0
fi

if [ "$TESTALL" = "testall" ]; then
    for base in $SIEVEVARIANTS; do
    # for base in sieve_base sieve_extend sieve_classic64 sieve_classic8 sieve_wheel sieve_wheel_8of30; do
        $0 $base --check 3 --verbose 3 "$@" || exit $?
    done
    exit 0
fi

# running the full benchmark set
if [ "$RUNALL" = "runall" ]; then
    for base in sieve_extend; do
        bin/${base}_epar --threads all "$@"
    done
    for base in $SIEVEVARIANTS; do
        bin/${base} "$@"
    done
    exit 0
fi

# Handle render command: export video from a trace file
if [ "$RENDER" = "render" ]; then
    RENDER_FILE=""
    # Look for a .sievetrace file in remaining args
    for arg in "$@"; do
        case "$arg" in
            *.sievetrace) RENDER_FILE="$arg" ;;
        esac
    done
    # Default to latest trace file
    if [ -z "$RENDER_FILE" ]; then
        RENDER_FILE=$(ls -t log/*.sievetrace 2>/dev/null | head -1)
    fi
    # Try log/ prefix
    if [ -n "$RENDER_FILE" ] && [ ! -f "$RENDER_FILE" ] && [ -f "log/$RENDER_FILE" ]; then
        RENDER_FILE="log/$RENDER_FILE"
    fi
    if [ -z "$RENDER_FILE" ] || [ ! -f "$RENDER_FILE" ]; then
        echo -e "No trace file found. Generate one with: ${CCYAN}./sieve trace <variant>${CRESET}"
        exit 1
    fi
    RENDER_FILE="$(cd "$(dirname "$RENDER_FILE")" && pwd)/$(basename "$RENDER_FILE")"
    echo -e "Rendering video from ${CYELLOW}$(basename "$RENDER_FILE")${CRESET}..."
    # Ensure web visualizer is built
    if [ ! -d web-visualizer/dist ]; then
        echo "Building web visualizer..."
        (cd web-visualizer && npx vite build 2>&1 | tail -5)
    fi
    node web-visualizer/scripts/render-video.mjs "$RENDER_FILE"
    exit $?
fi

# If the first argument does not start with '-', assign it as the base and discard it
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    if echo "$1" | grep -qE '^[0-9]+$'; then
        # If it's a number, keep it as an argument
        :
    else
        base="$1"
        shift
    fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# Chain mode: tune → benchmark → timing → explain → trace → visualize
# ─────────────────────────────────────────────────────────────────────────────
if [ "$CHAIN" = "chain" ]; then
    [ -d ./log ] || mkdir ./log
    CHAIN_TS=$(date "+%Y-%m-%d_%H-%M")
    CHAIN_MAX="${highest_number:-1000000}"
    [ "$CHAIN_MAX" -eq 0 ] && CHAIN_MAX=1000000
    CHAIN_LOGBASE="log/${CHAIN_TS}_${base}_${CHAIN_MAX}"
    [ "$CHAIN_TITLE" ] && CHAIN_LOGBASE="log/${CHAIN_TS}_${CHAIN_TITLE}" ||

    # Forward compiler choice and sieve size to sub-invocations
    CHAIN_FWD=()
    [ -n "$COMPILER_OVERRIDE" ] && CHAIN_FWD+=("$COMPILER_OVERRIDE")
    [ "${CHAIN_MAX:-0}" -gt 0 ]  && CHAIN_FWD+=("$CHAIN_MAX")
    if [ -n "$USER_SET_OVERRIDE" ]; then
        [ -d ./dev/build ] || mkdir -p ./dev/build
        echo -n "$USER_SET_OVERRIDE" > "./dev/build/${base}_settings.txt"
        CHAIN_FWD+=("--set" "$USER_SET_OVERRIDE")
    fi

    echo -e "\n=== ${CYELLOW}Chain mode${CRESET}: ${CCYAN}${base}${CRESET} up to ${CHAIN_MAX} ==="
    echo -e "Log base: ${CGREEN}${CHAIN_LOGBASE}${CRESET}\n"

    # ── 1/6: Tune ────────────────────────────────────────────────────────────
    echo -e "${CYELLOW}[1/6]${CRESET} Compiling tune variant..."
    $0 "${base}" compile --verbose 2 "${CHAIN_FWD[@]}" || exit $?
    if [ -n "$USER_SET_OVERRIDE" ]; then
        echo -e "${CYELLOW}[1/6]${CRESET} Skipping tune run (using explicit --set ${USER_SET_OVERRIDE})."
    else
        echo -e "${CYELLOW}[1/6]${CRESET} Running tune (finding best settings)..."
        ./bin/${base} --tune 5 --nocheck --verbose 2 "${CHAIN_FWD[@]}" || exit $?
    fi

    # ── 2/6: Benchmark (embedded settings, 5-second run) ─────────────────────
    echo -e "\n${CYELLOW}[2/6]${CRESET} Compiling embedded benchmark variant..."
    $0 "${base}" embedded compile --verbose 2 "${CHAIN_FWD[@]}" || exit $?
    echo -e "${CYELLOW}[2/6]${CRESET} Running 5-second benchmark..."
    ./bin/${base}_embedded --verbose 1 "${CHAIN_FWD[@]}" \
        | tee "${CHAIN_LOGBASE}.bench.txt" || exit $?

    # ── 3/6: Timing (embedded + COMPILE_TIMERS, 5-second run) ────────────────
    echo -e "\n${CYELLOW}[3/6]${CRESET} Compiling timing variant..."
    $0 "${base}" timing compile --verbose 2 "${CHAIN_FWD[@]}" || exit $?
    echo -e "${CYELLOW}[3/6]${CRESET} Running 5-second timing..."
    ./bin/${base}_timing --notune --nocheck --verbose 2 --timers \
        --benchmark-log "${CHAIN_LOGBASE}_sievebenchmark.json" \
        "${CHAIN_FWD[@]}" || exit $?
    echo -e "Timing log: ${CCYAN}${CHAIN_LOGBASE}_sievebenchmark.json${CRESET}"

    # ── 4/6: Compile trace+explain binary (shared by steps 4 and 5) ──────────
    echo -e "\n${CYELLOW}[4/6]${CRESET} Compiling trace+explain variant..."
    $0 "${base}" visualize explain compile --verbose 2 "${CHAIN_FWD[@]}" || exit $?
    echo -e "${CYELLOW}[4/6]${CRESET} Running explain (output → ${CHAIN_LOGBASE}.explain.txt)..."
    ./bin/${base}_trace --verbose 7 --explain \
        "${CHAIN_FWD[@]}" > "${CHAIN_LOGBASE}.explain.txt" 2>&1 || exit $?
    echo -e "Explain log: ${CCYAN}${CHAIN_LOGBASE}.explain.txt${CRESET}"

    # ── 5/6: Trace (same binary, with trace output) ───────────────────────────
    echo -e "\n${CYELLOW}[5/6]${CRESET} Running trace..."
    [ "${CHAIN_TITLE}" ] && CHAIN_FWD+=("--trace-title" "${CHAIN_TITLE}")
    ./bin/${base}_trace --verbose 2 \
        --trace 9 --trace-filename "${CHAIN_LOGBASE}.sievetrace" \
        "${CHAIN_FWD[@]}" || exit $?
    echo -e "Trace file:  ${CCYAN}${CHAIN_LOGBASE}.sievetrace${CRESET}"

    # ── 6/6: Visualize ────────────────────────────────────────────────────────
    echo -e "\n${CYELLOW}[6/6]${CRESET} Starting visualizer..."
    CHAIN_TRACE_ABS="$(cd "$(dirname "${CHAIN_LOGBASE}.sievetrace")" && pwd)/$(basename "${CHAIN_LOGBASE}.sievetrace")"
    CHAIN_FILE_PARAM=$(basename "${CHAIN_LOGBASE}.sievetrace")

    if [ ! -d web-visualizer/node_modules ]; then
        echo "Installing web visualizer dependencies..."
        (cd web-visualizer && npm install 2>&1 | tail -5)
    fi

    USE_ELECTRON=false
    if [ "$VISUALIZE_MODE" = "native" ]; then
        USE_ELECTRON=true
    elif [ "$VISUALIZE_MODE" = "web" ]; then
        USE_ELECTRON=false
    elif command -v npx >/dev/null 2>&1 && (cd web-visualizer && npx electron --version >/dev/null 2>&1); then
        USE_ELECTRON=true
    fi

    if [ "$USE_ELECTRON" = true ]; then
        if [ ! -d web-visualizer/dist ]; then
            echo "Building web visualizer..."
            (cd web-visualizer && npx vite build 2>&1 | tail -5)
        fi
        echo -e "Starting native app with ${CYELLOW}${CHAIN_FILE_PARAM}${CRESET}..."
        (cd web-visualizer && npx electron . "${CHAIN_TRACE_ABS}")
    else
        # Start Vite dev server in background and capture output to find port
        VITE_LOG="log/vite.log"
        (cd web-visualizer && npx vite > "../$VITE_LOG" 2>&1) &
        VITE_PID=$!
        
        # Wait for Vite to start and output the port
        echo -n "Waiting for Vite to start..."
        MAX_WAIT=10
        DETECTED_PORT=""
        for i in $(seq 1 $MAX_WAIT); do
            sleep 1
            echo -n "."
            DETECTED_PORT=$(grep -oE 'http://localhost:[0-9]+' "$VITE_LOG" | head -1 | cut -d':' -f3)
            if [ -n "$DETECTED_PORT" ]; then
                break
            fi
        done
        echo ""

        if [ -z "$DETECTED_PORT" ]; then
            DETECTED_PORT="5173"
            echo -e "Vite port not detected, falling back to ${CYELLOW}$DETECTED_PORT${CRESET}"
        fi

        CHAIN_URL="http://localhost:${DETECTED_PORT}/?file=${CHAIN_FILE_PARAM}"
        sleep 1
        (wslview "$CHAIN_URL" || xdg-open "$CHAIN_URL" || open "$CHAIN_URL" || sensible-browser "$URL") 2>/dev/null || \
            echo -e "Open ${CCYAN}${CHAIN_URL}${CRESET} in your browser."
        echo -e "Visualizer running at ${CCYAN}${CHAIN_URL}${CRESET}"
        echo "Press Ctrl+C to stop."
        wait $VITE_PID
    fi
    exit 0
fi

# Set default compiler flags for all compilers
COMPILER_ASM=""
COMPILER=""
CC="-mtune=native -fno-asynchronous-unwind-tables -fno-exceptions -Wall -Wno-unused-function -Wno-unused-variable -Wno-unknown-pragmas -std=c11 -fno-common -fdata-sections -ffunction-sections"  #  -Wno-unused-function -fno-common -fdata-sections -ffunction-sections 
CC="-fno-ident  -ffreestanding $CC" # -nostdlib
# CC="$CC -funroll-loops "
# CC="$CC -Rpass=loop-unroll -Rpass-missed=loop-unroll"
CCWARN=""
# CCWARN="-Wall -Wno-unknown-pragmas" 

# Determine which compiler to use based on override or auto-detection
# Prefer icx (intel) if available on intel systems, otherwise fallback to clang on macOS or gcc on Linux
if [ -n "$COMPILER_OVERRIDE" ]; then
  COMPILER="$COMPILER_OVERRIDE"
elif [ "$ARCH" = "arm64" ]; then
    if command -v icx >/dev/null 2>&1; then
        COMPILER="icx"
    elif command -v clang >/dev/null 2>&1; then
        COMPILER="clang"
    else
        COMPILER="gcc"
    fi
else 
    if command -v icx >/dev/null 2>&1; then
        COMPILER="icx"
    elif command -v gcc-15 >/dev/null 2>&1; then
        COMPILER="gcc-15"
    else
        COMPILER="gcc"
    fi
fi

# Configure compiler settings based on selection
if [ "$COMPILER" = "clang" ]; then
    CC="$CC -march=armv8-a+simd"
    CCASM="clang $CC -S -g -Wno-psabi -masm=intel -mllvm --x86-asm-syntax=intel -fverbose-asm" 
    CC="clang $CC -O3 -ffast-math -Wno-psabi -flto -fvisibility=hidden -ffunction-sections -fdata-sections -I/usr/lib/llvm-18/lib/clang/18/include/immintrin.h"  
    CC="$CC -Wl,-dead_strip"
    # CC="clang -fsanitize=address " # use this for debugging

    # Ensure Clang finds OpenMP headers and library
    if [ "$OS" = "Darwin" ]; then
        # macOS paths for Clang omp
        PAR="-Xpreprocessor -fopenmp -lomp -I$(brew --prefix libomp)/include -L$(brew --prefix libomp)/lib"
    else
        # Linux paths for Clang omp - find the actual omp.h location
        OMP_INCLUDE=$(find /usr/lib/llvm* -name "omp.h" -path "*/include*" | head -n 1)
        if [ -n "$OMP_INCLUDE" ]; then
            OMP_DIR=$(dirname "$OMP_INCLUDE")
            # Find the library directory by looking for libomp.so
            OMP_LIB_DIR=$(find /usr/lib/llvm* -name "libomp.so" | head -n 1)
            if [ -n "$OMP_LIB_DIR" ]; then
                OMP_LIB_PATH=$(dirname "$OMP_LIB_DIR")
                PAR="-fopenmp -I$OMP_DIR -L$OMP_LIB_PATH -lomp"
            else
                # Try guessing the lib directory structure
                OMP_LIB_PATH=$(echo "$OMP_DIR" | sed 's|/include.*$|/lib|')
                PAR="-fopenmp -I$OMP_DIR -L$OMP_LIB_PATH -lomp"
            fi
        else
            # Fallback to standard OpenMP paths when installed with libomp-dev
            PAR="-fopenmp -lomp -I/usr/lib/gcc/x86_64-linux-gnu/14/include/ "
        fi
    fi
elif [ "$COMPILER" = "icx" ] || [ "$COMPILER" = "intel" ] || [ "$COMPILER" = "oneapi" ]; then
    CCASM="icx $CC -S -g -Wno-psabi -masm=intel -mllvm --x86-asm-syntax=intel -fverbose-asm" 
    CC="icx $CC -O3 -ffast-math -Wno-psabi -flto -fvisibility=hidden -ffunction-sections -fdata-sections"  # -Wl,-dead_strip
elif [ "$COMPILER" = "gcc" ] || [ "$COMPILER" = "gcc-15" ]; then
    COMPILER_NAME="gcc"
    if command -v gcc-15 >/dev/null 2>&1; then
        COMPILER_NAME="gcc-15"
    fi
    if [ "$OS" = "Darwin" ]; then
        CC=" -mcpu=apple-m1 $CC" # -march=armv8.5-a
    else
        CC="-march=native $CC" 
    fi

    CCASM="$COMPILER_NAME $CC -S -g -Wno-psabi -masm=intel -fverbose-asm -Wextra -fopt-info-vec-all=vec_report.txt" # -mavx
    CC="$COMPILER_NAME $CC -Ofast -Wno-psabi -fwhole-program -flto -I/usr/lib/gcc/x86_64-linux-gnu/14/include/ -flto=auto" # -static -Wvector-operation-performance " # for windows add this: -s -masm=intel -fverbose-asm -mavx -fopt-info-vec-all=vec_report.txt
    # CC="-Wl,--gc-sections -s $CC"
    PAR="-fopenmp"
fi

# create a bin directory if it does not exist
[ -d ./bin ] || mkdir ./bin

# Auto-enable embed for timing/embedded/trace/visualize variants when settings are already saved
if [ "$CHAIN_TIMING_MODE" = "timing" ] || [ "$CHAIN_EMBED_MODE" = "embedded" ] || \
   [ "$VISUALIZE" = "visualize" ] || [ "$TRACE" = "trace" ]; then
    if [ -z "$EMBED" ] && [ -f "./dev/build/${base}_settings.txt" ]; then
        EMBED="embed"
    fi
fi

# Handle --embed: use compile-time constants from last saved settings
if [ "$EMBED" = "embed" ]; then
    EMBED_FILE="./src/generic/sieve_embed.h"
    SETTINGS_FILE="./dev/build/${base}_settings.txt"

    if [ ! -f "$SETTINGS_FILE" ]; then
        echo "Error: No saved settings found at $SETTINGS_FILE"
        echo "Run without --embed first to auto-save settings."
        exit 1
    fi

    EMBED_SET=$(cat "$SETTINGS_FILE" | tr -d '\n')
    if [ $verbose_level -gt 1 ]; then
        echo -e "Embedding settings from ${CYELLOW}${SETTINGS_FILE}${CRESET}: ${CGREEN}${EMBED_SET}${CRESET}"
    fi

    # Parse settings string and generate the embed header
    EMBED_STRIPE=0; EMBED_LARGESTEP=0; EMBED_BLOCKSIZE=0; EMBED_VECTORSIZE=0
    p="$EMBED_SET"
    while [ -n "$p" ]; do
        case "$p" in -*) p="${p#-}"; continue ;; esac
        param_type="${p:0:1}"; p="${p:1}"; num=""
        while [ -n "$p" ] && [[ "${p:0:1}" =~ [0-9] ]]; do num="${num}${p:0:1}"; p="${p:1}"; done
        num=$((10#${num:-0}))
        case "$param_type" in
            s) EMBED_STRIPE=$num ;; l) EMBED_LARGESTEP=$num ;;
            b) EMBED_BLOCKSIZE=$num ;; v) EMBED_VECTORSIZE=$num ;;
        esac
    done
    cat > "$EMBED_FILE" <<EMBED_EOF
// Auto-generated by ./sieve --embed from $SETTINGS_FILE
#ifndef SIEVE_EMBED_H
#define SIEVE_EMBED_H
static const counter_t global_stripeprime_faster  = ${EMBED_STRIPE};
static const counter_t global_largestep_faster    = ${EMBED_LARGESTEP};
static const counter_t global_blocksize_bits      = ${EMBED_BLOCKSIZE};
static const counter_t global_vectorsize          = ${EMBED_VECTORSIZE};
#endif
EMBED_EOF

    DEFINE_FLAGS="-DEMBED_SETTINGS $DEFINE_FLAGS"
    # Pass saved settings via --set so the struct matches the embedded constants
    # Strip any user-supplied --set from $@ to avoid conflicts
    FILTERED_ARGS=()
    SKIP_NEXT=0
    for arg in "$@"; do
        if [ $SKIP_NEXT -eq 1 ]; then SKIP_NEXT=0; continue; fi
        if [ "$arg" = "--set" ]; then SKIP_NEXT=1; continue; fi
        FILTERED_ARGS+=("$arg")
    done
    set -- "${FILTERED_ARGS[@]}"
    run_args="$run_args --notune --nocheck --set $EMBED_SET"
fi

# Strip .c extension if provided
base="${base%.c}"

# Resolve source file: try ./src/${base}.c, then ./src/sieve_${base}.c
if [ -f "./src/${base}.c" ]; then
    srcfile="./src/${base}.c"
elif [ -f "./src/sieve_${base}.c" ]; then
    base="sieve_${base}"
    srcfile="./src/${base}.c"
else
    echo "Error: Source file not found: ./src/${base}.c or ./src/sieve_${base}.c"
    exit 1
fi

# Compose a program name using a default base name.
PROGTOTAL="${base}${PROGRAM_SUFFIX}"

if [ $verbose_level -gt 1 ]; then
    echo -e "Compiling ${CYELLOW}${PROGTOTAL}${CRESET} for ${CCYAN}${OS}${CRESET} with ${CGREEN}${COMPILER}${CRESET} "
fi

if [ $verbose_level -gt 2 ]; then
  echo -e "Issuing command: ${CGREEN}$CC${CRESET} -o ./bin/${CYELLOW}$PROGTOTAL${CRESET} ${CYELLOW}${srcfile}${CRESET} $DEFINE_FLAGS"
fi

$CC -o ./bin/$PROGTOTAL $srcfile $DEFINE_FLAGS $CCWARN

compile_status=$?
if [ $compile_status -ne 0 ]; then
    echo "Error: Compilation failed for sequential version."
    exit $compile_status
fi

if [ "$COMPILER_ASM" = "asm" ]; then
    if [ "$COMPILER" = "gcc" ]; then
        $CCASM -o ./dev/build/$PROGTOTAL.s $srcfile $DEFINE_FLAGS
    else #clang
        echo -e "Running ${CGREEN}$CCASM${CRESET} -o ./dev/build/${CYELLOW}$PROGTOTAL.s${CRESET} ${CYELLOW}${srcfile}${CRESET} $DEFINE_FLAGS" 
        $CCASM -o ./dev/build/$PROGTOTAL.s $srcfile $DEFINE_FLAGS
    fi
fi
$STRIP ./bin/$PROGTOTAL

strip_status=$?
if [ $strip_status -ne 0 ]; then
    echo "Error: Stripping failed for sequential version."
    exit $strip_status
fi

if [ $threads -gt 0 ]; then
    PROGTOTALPAR="${base}$PAREXT${PROGRAM_SUFFIX}"
    if [ $verbose_level -gt 1 ]; then
        echo -e "Compiling ${CYELLOW}${PROGTOTALPAR}${CRESET} for ${CCYAN}${OS}${CRESET} with ${CGREEN}${COMPILER}${CRESET} "
    fi

    if [ $verbose_level -gt 2 ]; then
    echo -e "Issuing command: ${CGREEN}$CC${CRESET} $PAR -o ./bin/${CYELLOW}$PROGTOTALPAR${CRESET} ${CYELLOW}${srcfile}${CRESET} $DEFINE_FLAGS"
    fi
    $CC $PAR -o ./bin/$PROGTOTALPAR $srcfile $DEFINE_FLAGS
    compile_par_status=$?
    if [ $compile_par_status -ne 0 ]; then
        echo "Error: Compilation failed for parallel version."
        exit $compile_par_status
    fi
    $STRIP ./bin/$PROGTOTALPAR
    strip_par_status=$?
    if [ $strip_par_status -ne 0 ]; then
        echo "Error: Stripping failed for parallel version."
        exit $strip_par_status
    fi
fi

if [ "$COMPILE" = "compile" ]; then
    exit 0; # stop here
fi

if [ $threads -gt 0 ]; then
    EXECUTABLE_PATH="./bin/$PROGTOTALPAR"
    if [ $verbose_level -gt 1 ]; then
        echo -e "Running parallel version: ${CYELLOW}${EXECUTABLE_PATH}${CRESET} $run_args $@"
    fi
else
    EXECUTABLE_PATH="./bin/$PROGTOTAL"
    if [ $verbose_level -gt 2 ]; then
        echo -e "Running ${CYELLOW}${EXECUTABLE_PATH}${CRESET} $run_args $@"
    fi
fi

if [ "$STABLE_MODE" = "stable" ]; then
    if [ "$OS" = "Darwin" ]; then
        if [ $verbose_level -gt 0 ]; then
            echo -e "Stable mode autodetect: ${CCYAN}macOS${CRESET}"
        fi
        bash ./dev/benchmark/run-macos-stable.sh "$EXECUTABLE_PATH" $run_args "$@"
    elif [ "$OS" = "Linux" ]; then
        if is_wsl_environment && [ $verbose_level -gt 0 ]; then
            echo -e "Stable mode autodetect: ${CCYAN}WSL/Linux guest${CRESET}"
            echo "Hint: for host affinity + .wslconfig setup, run './sieve stable-setup' and use the PowerShell launcher in ./dev/benchmark."
        elif [ $verbose_level -gt 0 ]; then
            echo -e "Stable mode autodetect: ${CCYAN}Linux${CRESET}"
        fi
        bash ./dev/benchmark/run-linux-stable.sh "$EXECUTABLE_PATH" $run_args "$@"
    else
        echo "Stable mode not supported on this OS. Running once instead."
        "$EXECUTABLE_PATH" $run_args "$@"
    fi
else
    if [ "$STABLE_WSL_HOST" = "stable-wsl-host" ]; then
        if [ $verbose_level -gt 0 ]; then
            echo -e "Stable mode autodetect: ${CCYAN}WSL host+guest${CRESET}"
        fi

        if ! command -v powershell.exe >/dev/null 2>&1; then
            echo "powershell.exe not found. Cannot launch host-affinity benchmark from WSL."
            exit 1
        fi

        PS1_WIN_PATH=$(wslpath -w "$(pwd)/dev/benchmark/run-wsl-benchmark.ps1")
        DISTRO_NAME="${WSL_DISTRO_NAME:-Ubuntu}"
        AFFINITY_MASK="${PRIME_BENCHMARK_AFFINITY_MASK:-1}"
        LINUX_REPO_PATH="$(pwd)"

        benchmark_words=("./dev/benchmark/run-linux-stable.sh" "$EXECUTABLE_PATH")
        if [ -n "$run_args" ]; then
            # shellcheck disable=SC2206
            run_args_words=($run_args)
            benchmark_words+=("${run_args_words[@]}")
        fi
        benchmark_words+=("$@")

        printf -v BENCHMARK_COMMAND_ESCAPED '%q ' "${benchmark_words[@]}"
        BENCHMARK_COMMAND_ESCAPED="${BENCHMARK_COMMAND_ESCAPED% }"

        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS1_WIN_PATH" \
            -Distro "$DISTRO_NAME" \
            -AffinityMask "$AFFINITY_MASK" \
            -LinuxRepoPath "$LINUX_REPO_PATH" \
            -BenchmarkCommand "$BENCHMARK_COMMAND_ESCAPED"
    else
        "$EXECUTABLE_PATH" $run_args "$@"
    fi
fi

# Handle visualize: start web visualizer with the latest trace
if [ "$VISUALIZE" = "visualize" ]; then
    LATEST=$(ls -t log/*.sievetrace 2>/dev/null | head -1)
    if [ -n "$LATEST" ]; then
        FILE_PARAM=$(basename "$LATEST")
        echo ""
        echo -e "Opening visualizer with ${CYELLOW}${FILE_PARAM}${CRESET}..."

        # Ensure web visualizer dependencies are installed
        if [ ! -d web-visualizer/node_modules ]; then
            echo "Installing web visualizer dependencies..."
            (cd web-visualizer && npm install 2>&1 | tail -5)
        fi

        # Determine mode: native, web, or auto-detect
        USE_ELECTRON=false
        if [ "$VISUALIZE_MODE" = "native" ]; then
            USE_ELECTRON=true
        elif [ "$VISUALIZE_MODE" = "web" ]; then
            USE_ELECTRON=false
        elif command -v npx >/dev/null 2>&1 && (cd web-visualizer && npx electron --version >/dev/null 2>&1); then
            USE_ELECTRON=true
        fi

        if [ "$USE_ELECTRON" = true ]; then
            # Build the web app if needed
            if [ ! -d web-visualizer/dist ]; then
                echo "Building web visualizer..."
                (cd web-visualizer && npx vite build 2>&1 | tail -5)
            fi
            TRACE_PATH="$(cd "$(dirname "$LATEST")" && pwd)/$(basename "$LATEST")"
            echo -e "Starting native app..."
            (cd web-visualizer && npx electron . "$TRACE_PATH")
        else
            # Start Vite dev server in background and capture output to find port
            mkdir -p web-visualizer/logs
            VITE_LOG="web-visualizer/logs/vite_visualize.log"
            (cd web-visualizer && npx vite > "../$VITE_LOG" 2>&1) &
            VITE_PID=$!
            
            # Wait for Vite to start and output the port
            echo -n "Waiting for Vite to start..."
            MAX_WAIT=10
            DETECTED_PORT=""
            for i in $(seq 1 $MAX_WAIT); do
                sleep 1
                echo -n "."
                DETECTED_PORT=$(grep -oE 'http://localhost:[0-9]+' "$VITE_LOG" | head -1 | cut -d':' -f3)
                if [ -n "$DETECTED_PORT" ]; then
                    break
                fi
            done
            echo ""

            if [ -z "$DETECTED_PORT" ]; then
                DETECTED_PORT="5173"
                echo -e "Vite port not detected, falling back to ${CYELLOW}$DETECTED_PORT${CRESET}"
            fi

            URL="http://localhost:${DETECTED_PORT}/?file=${FILE_PARAM}"
            sleep 1

            # Try to open browser
            (wslview "$URL" || xdg-open "$URL" || open "$URL" || sensible-browser "$URL") 2>/dev/null || \
                echo -e "Open ${CCYAN}${URL}${CRESET} in your browser."

            echo -e "Visualizer running at ${CCYAN}${URL}${CRESET}"
            echo "Press Ctrl+C to stop."
            wait $VITE_PID
        fi
    else
        echo "No trace file generated."
    fi
fi
