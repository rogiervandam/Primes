FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y software-properties-common \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update \
    && apt-get install -y build-essential gcc-14 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 60 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/sieve

# Copy all shell scripts, C source, and header files
COPY src/ ./src/
COPY tools/ ./tools/

# Copy builder
COPY sieve ./sieve

# Ensure the bin directory exists
RUN mkdir -p bin
RUN mkdir -p dev/build

# Make the sieve executable and resolve LF/CRLF issues
RUN chmod +x ./tools/* ./sieve
RUN sed -i 's/\r$//' ./tools/* ./sieve

ENTRYPOINT [ "./sieve" ]
